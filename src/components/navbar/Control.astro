---
import siteList from '../../data/siteList'
import Dropdown from './Dropdown.astro'
---

<!-- mobile menu toggle -->
<label
  id="drawer-opener"
  for="drawer-toggle"
  class="GTM-mobile-toggle ml-3 inline-flex items-center rounded-md p-2 text-sm md:hidden"
  aria-label="open sidebar"
>
  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"
    ><path
      fill-rule="evenodd"
      d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
      clip-rule="evenodd"></path></svg
  >
</label>
<div class="hidden w-full md:block md:w-auto">
  <ul
    class="menu menu-horizontal flex flex-col md:ml-32 md:flex-row md:space-x-1 md:text-sm md:font-medium xl:ml-0"
  >
    {
      Object.entries(siteList)
        .reverse()
        .map(([year, list]) => <Dropdown year={Number(year)} list={list} />)
    }
  </ul>
</div>
